<Window x:Class="StructureHelper.Windows.Materials.CustomConcreteModelView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StructureHelper.Windows.Materials"
        xmlns:vm="clr-namespace:StructureHelper.Windows.ViewModels.Materials"
        xmlns:uc="clr-namespace:StructureHelper.Windows.Materials"
        d:DataContext="{d:DesignInstance vm:CustomConcreteModelEditViewModel}"
        mc:Ignorable="d"
        Title="Custom concrete model" Height="430" Width="500"
        MinHeight="380" MinWidth="460" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <Grid></Grid>
        <TabControl>
            <TabItem Header="General">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Name" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Margin="3"
                             Style="{StaticResource ValidatedError}"
                             KeyDown="NumericTextBox_KeyDown"
                             Text="{Binding Name, ValidatesOnDataErrors=True}"/>

                    <TextBlock Grid.Row="1" Text="Active" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="1" Grid.Column="1" Margin="3" VerticalAlignment="Center"
                              IsChecked="{Binding IsActive, ValidatesOnDataErrors=True}"/>

                    <TextBlock Grid.Row="2" Text="Young modulus, MPa" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="3"
                             Style="{StaticResource ValidatedError}"
                             KeyDown="NumericTextBox_KeyDown"
                             Text="{Binding YoungModulus, Converter={StaticResource StressConverter}, ValidatesOnDataErrors=True, ValidatesOnExceptions=True}"/>

                    <TextBlock Grid.Row="3" Text="Limit state" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" Margin="3"
                              ItemsSource="{Binding LimitStatesCollection}"
                              SelectedItem="{Binding LimitState, ValidatesOnDataErrors=True}"/>

                    <TextBlock Grid.Row="4" Text="Calculation term" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="4" Grid.Column="1" Margin="3"
                              ItemsSource="{Binding CalcTermsCollection}"
                              SelectedItem="{Binding CalcTerm, ValidatesOnDataErrors=True}"/>
                </Grid>
            </TabItem>

            <TabItem Header="Compression">
                <uc:CustomConcreteCompressionOptionsView DataContext="{Binding CompressionOptions}"/>
            </TabItem>

            <TabItem Header="Tension">
                <uc:CustomConcreteTensionOptionsView DataContext="{Binding TensionOptions}"/>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource CancelButton}" Command="{Binding CancelCommand}"/>
            <Button Style="{StaticResource OkButton}" Command="{Binding OkCommand}"/>
        </StackPanel>
    </Grid>
</Window>
