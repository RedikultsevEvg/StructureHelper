<Window x:Class="StructureHelper.Windows.Points.PointsCollectionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StructureHelper.Windows.Points"
        xmlns:uc="clr-namespace:StructureHelper.Windows.UserControls"
        d:DataContext="{d:DesignInstance local:PointsCollectionViewModel}"
        mc:Ignorable="d"
        Title="Points" Height="500" Width="800" MinHeight="300" MinWidth="500"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar Name="Points">
                <Button Style="{DynamicResource ToolButton}" Command="{Binding AddPointCommand}">
                    <Button.ToolTip>
                        <uc:ButtonToolTipEh HeaderText="Add point"
                                            IconContent="{StaticResource TableRowAdd}"
                                            DescriptionText="Adds a new point to the end of the collection"/>
                    </Button.ToolTip>
                    <Viewbox>
                        <ContentControl ContentTemplate="{StaticResource TableRowAdd}"/>
                    </Viewbox>
                </Button>
                <Button Style="{DynamicResource ToolButton}" Command="{Binding DeletePointCommand}">
                    <Button.ToolTip>
                        <uc:ButtonToolTipEh HeaderText="Delete point"
                                            IconContent="{StaticResource TableRowDelete}"
                                            DescriptionText="Removes the selected point from the collection"/>
                    </Button.ToolTip>
                    <Viewbox>
                        <ContentControl ContentTemplate="{StaticResource TableRowDelete}"/>
                    </Viewbox>
                </Button>
            </ToolBar>
            <ToolBar Name="Clipboard">
                <Button Style="{DynamicResource ToolButton}" Command="{Binding CopyToClipboardCommand}">
                    <Button.ToolTip>
                        <uc:ButtonToolTipEh HeaderText="Copy to clipboard"
                                            IconContent="{StaticResource CopyToClipboard}"
                                            DescriptionText="Copies the selected point, or all points if nothing is selected, as tab-separated text"/>
                    </Button.ToolTip>
                    <Viewbox>
                        <ContentControl ContentTemplate="{StaticResource CopyToClipboard}"/>
                    </Viewbox>
                </Button>
                <Button Style="{DynamicResource ToolButton}" Command="{Binding PasteFromClipboardCommand}">
                    <Button.ToolTip>
                        <uc:ButtonToolTipEh HeaderText="Paste from clipboard"
                                            IconContent="{StaticResource PasteFromClipboard}"
                                            DescriptionText="Adds points from tab-separated text in the clipboard"/>
                    </Button.ToolTip>
                    <Viewbox>
                        <ContentControl ContentTemplate="{StaticResource PasteFromClipboard}"/>
                    </Viewbox>
                </Button>
            </ToolBar>
            <ToolBar Name="Excel">
                <Button Style="{DynamicResource ToolButton}" Command="{Binding ImportFromExcelCommand}">
                    <Button.ToolTip>
                        <uc:ButtonToolTipEh HeaderText="Import from Excel"
                                            IconContent="{StaticResource ImportFromExcel}"
                                            DescriptionText="Imports points from the first sheet of an Excel workbook: X and Y in millimetres"/>
                    </Button.ToolTip>
                    <Viewbox>
                        <ContentControl ContentTemplate="{StaticResource ImportFromExcel}"/>
                    </Viewbox>
                </Button>
                <Button Style="{DynamicResource ToolButton}" Command="{Binding ExportToExcelCommand}">
                    <Button.ToolTip>
                        <uc:ButtonToolTipEh HeaderText="Export to Excel"
                                            IconContent="{StaticResource ExportToXLS}"
                                            DescriptionText="Exports all points to a new Excel workbook as two columns: X and Y in millimetres"/>
                    </Button.ToolTip>
                    <Viewbox>
                        <ContentControl ContentTemplate="{StaticResource ExportToXLS}"/>
                    </Viewbox>
                </Button>
            </ToolBar>
            <ToolBar Name="Chart">
                <Button Style="{DynamicResource ToolButton}" Command="{Binding ShowChartCommand}">
                    <Button.ToolTip>
                        <uc:ButtonToolTipEh HeaderText="Show chart"
                                            IconContent="{StaticResource ValuePointDiagram}"
                                            DescriptionText="Shows the points as a Y(X) chart in the graph window"/>
                    </Button.ToolTip>
                    <Viewbox>
                        <ContentControl ContentTemplate="{StaticResource ValuePointDiagram}"/>
                    </Viewbox>
                </Button>
            </ToolBar>
        </ToolBarTray>
        <Grid DockPanel.Dock="Bottom" Margin="5">
            <TextBlock Text="{Binding PointsCount, StringFormat=Points: {0}}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Coordinates are in mm" Margin="0,0,15,0" VerticalAlignment="Center" Foreground="Gray"/>
                <Button Content="Close" Width="80" IsCancel="True"/>
            </StackPanel>
        </Grid>
        <DataGrid ItemsSource="{Binding Points}"
                  SelectedItem="{Binding SelectedPoint}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Margin="5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="X, mm" Width="160" CanUserSort="False"
                                    Binding="{Binding X, Converter={StaticResource LengthConverter}, ValidatesOnDataErrors=True}"/>
                <DataGridTextColumn Header="Y, mm" Width="160" CanUserSort="False"
                                    Binding="{Binding Y, Converter={StaticResource LengthConverter}, ValidatesOnDataErrors=True}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
