<Window x:Class="StructureHelper.Windows.Materials.CustomConcreteMaterialView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StructureHelper.Windows.Materials"
        xmlns:vm="clr-namespace:StructureHelper.Windows.ViewModels.Materials"
        xmlns:uc="clr-namespace:StructureHelper.Windows.UserControls"
        d:DataContext="{d:DesignInstance vm:CustomConcreteMaterialViewModel}"
        mc:Ignorable="d"
        Title="{Binding Name}" Height="520" Width="780"
        MinHeight="420" MinWidth="680" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary Source="/Infrastructure/UI/Resources/Materials.xaml"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <ContentControl Grid.Row="0" ContentTemplate="{StaticResource MainMaterialProperties}" Content="{Binding}"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5,2">
            <CheckBox Content="Tension for ULS" IsChecked="{Binding TensionForULS}" Margin="0,0,20,0"/>
            <CheckBox Content="Tension for SLS" IsChecked="{Binding TensionForSLS}"/>
        </StackPanel>
        <TabControl Grid.Row="2">
            <TabItem Header="Models">
                <DockPanel>
                    <ToolBarTray DockPanel.Dock="Top">
                        <ToolBar>
                            <Button Style="{StaticResource ToolButton24}" Command="{Binding Models.Add}">
                                <Button.ToolTip>
                                    <uc:ButtonToolTipEh HeaderText="Add"
                                                IconContent="{StaticResource AddEntity}"
                                                DescriptionText="Adds a new custom concrete model"/>
                                </Button.ToolTip>
                                <Viewbox Height="24" Width="24">
                                    <ContentControl ContentTemplate="{DynamicResource AddEntity}"/>
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource ToolButton24}" Command="{Binding Models.Edit}">
                                <Button.ToolTip>
                                    <uc:ButtonToolTipEh HeaderText="Edit"
                                                IconContent="{StaticResource Settings}"
                                                DescriptionText="Edits the selected custom concrete model"/>
                                </Button.ToolTip>
                                <Viewbox Height="24" Width="24">
                                    <ContentControl ContentTemplate="{DynamicResource Settings}"/>
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource ToolButton24}" Command="{Binding Models.Copy}">
                                <Button.ToolTip>
                                    <uc:ButtonToolTipEh HeaderText="Copy"
                                                IconContent="{StaticResource CopyAnalysis}"
                                                DescriptionText="Creates a copy of the selected custom concrete model"/>
                                </Button.ToolTip>
                                <Viewbox Height="24" Width="24">
                                    <ContentControl ContentTemplate="{DynamicResource CopyAnalysis}"/>
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource ToolButton24}" Command="{Binding Models.Delete}">
                                <Button.ToolTip>
                                    <uc:ButtonToolTipEh HeaderText="Delete"
                                                IconContent="{StaticResource DeleteEntity}"
                                                DescriptionText="Deletes the selected custom concrete model"/>
                                </Button.ToolTip>
                                <Viewbox Height="24" Width="24">
                                    <ContentControl ContentTemplate="{DynamicResource DeleteEntity}"/>
                                </Viewbox>
                            </Button>
                        </ToolBar>
                    </ToolBarTray>
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="135"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Active" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Limit state" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="Calc term" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="E" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="Peak stress" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="Tension strength" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>

                        <ListBox Grid.Row="1"
                     ItemsSource="{Binding Models.Items}"
                     SelectedItem="{Binding Models.SelectedItem}"
                     SelectionMode="Single"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="135"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsActive}"
                                      IsHitTestVisible="False" Focusable="False"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding StateCalcTermPair.LimitState}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding StateCalcTermPair.CalcTerm}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding YoungModulus, Converter={StaticResource StressConverter}}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding CompressionOptions.PeakStress, Converter={StaticResource StressConverter}}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="{Binding TensionOptions.Strength, Converter={StaticResource StressConverter}}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Factors">
                <local:SafetyFactorsCollectionView DataContext="{Binding SafetyFactors}"/>
            </TabItem>
        </TabControl>
        <ContentControl Grid.Row="3" ContentTemplate="{StaticResource OkCancelButtons}" Content="{Binding}"/>
    </Grid>
</Window>
