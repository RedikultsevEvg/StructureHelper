<Window x:Class="StructureHelper.Windows.LoadHistory.HistoryResultDetailsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StructureHelper.Windows.LoadHistory"
        d:DataContext="{d:DesignInstance local:HistoryResultDetailsViewModel}"
        mc:Ignorable="d"
        Title="Step result details" Height="480" Width="520"
        MinHeight="420" MinWidth="420" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Stage:"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StageName}" TextWrapping="Wrap"/>
            <TextBlock Grid.Row="1" Text="Position:"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Position}"/>
            <TextBlock Grid.Row="2" Text="Step:"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StepNumber}"/>
            <TextBlock Grid.Row="3" Text="Time, s:"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Time, StringFormat={}{0:G6}}"/>
            <TextBlock Grid.Row="4" Text="Valid:"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding IsValid}"/>
            <TextBlock Grid.Row="5" Text="Description:"/>
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap"/>
        </Grid>

        <GroupBox Grid.Row="1" Header="Solution" Margin="0,0,0,8">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Achieved accuracy:"/>
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding AchievedAccuracy, StringFormat={}{0:E2}, TargetNullValue=—}"/>
                <TextBlock Grid.Row="1" Text="Required accuracy:"/>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding RequiredAccuracy, StringFormat={}{0:E2}, TargetNullValue=—}"/>
                <TextBlock Grid.Row="2" Text="Iterations:"/>
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="{Binding IterationCount, TargetNullValue=—}"/>
                <TextBlock Grid.Row="3" Text="Maximum iterations:"/>
                <TextBlock Grid.Row="3" Grid.Column="1"
                           Text="{Binding MaxIterationCount, TargetNullValue=—}"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Forces" Margin="0,0,0,8">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Nz, kN:"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding NzKilonewtons, StringFormat={}{0:G6}}"/>
                <TextBlock Grid.Row="1" Text="Mx, kNm:"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MxKilonewtonMeters, StringFormat={}{0:G6}}"/>
                <TextBlock Grid.Row="2" Text="My, kNm:"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MyKilonewtonMeters, StringFormat={}{0:G6}}"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Curvatures" Margin="0,0,0,8">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="EpsZ:"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EpsZ, StringFormat={}{0:G6}}"/>
                <TextBlock Grid.Row="1" Text="Kx, 1/mm:"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding KxPerMillimeter, StringFormat={}{0:G6}}"/>
                <TextBlock Grid.Row="2" Text="Ky, 1/mm:"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding KyPerMillimeter, StringFormat={}{0:G6}}"/>
            </Grid>
        </GroupBox>

        <Button Grid.Row="5" Content="Close" IsCancel="True" Width="80"
                HorizontalAlignment="Right" Margin="0,10,0,0"/>
    </Grid>
</Window>
